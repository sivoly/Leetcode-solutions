class Solution {
    public int maxProfit(int[] prices) {
        int n=prices.length;
        int minprice=Integer.MAX_VALUE;
        int maxprice=0;
        int profit;
        for(int i=0;i<n;i++)
        {
            if(prices[i]<minprice)
            {
                minprice=prices[i];
            }
            profit=prices[i]-minprice;
            if(profit>maxprice)
            {
                maxprice=profit;
            }
        }
        return maxprice;
    }
}
